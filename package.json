{
  "name": "nuxt-app",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build && npm run build:go",
    "build:go": "cd go-service && go build -o artemis-campaign-worker",
    "dev": "concurrently \"npm run dev:nuxt\" \"npm run dev:go\" --names \"NUXT,GO\" --prefix-colors \"green,blue\"",
    "dev:nuxt": "nuxt dev",
    "dev:go": "cd go-service && go run .",
    "generate": "nuxt generate",
    "start": "concurrently \"npm run start:nuxt\" \"npm run start:go\" --names \"NUXT,GO\" --prefix-colors \"green,blue\"",
    "start:nuxt": "node --env-file=.env .output/server/index.mjs",
    "start:go": "cd go-service && ./artemis-campaign-worker",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@nuxtjs/supabase": "^2.0.1",
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.19",
    "@vueuse/nuxt": "^14.0.0",
    "bcryptjs": "^3.0.3",
    "concurrently": "^9.2.1",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^7.0.11",
    "nuxt": "^4.2.1",
    "nuxt-emoji-picker": "^1.2.1",
    "vue": "^3.5.25",
    "vue-draggable-plus": "^0.6.0",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/nodemailer": "^7.0.4"
  }
}
