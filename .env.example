# ─────────────────────────────────────────────────────────────────────────────
# DATABASE (Neon PostgreSQL ou qualquer Postgres compatível)
# ─────────────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# ─────────────────────────────────────────────────────────────────────────────
# AUTENTICAÇÃO JWT
# ─────────────────────────────────────────────────────────────────────────────
JWT_SECRET=sua_chave_secreta_aqui_minimo_32_caracteres

# ─────────────────────────────────────────────────────────────────────────────
# EVOLUTION API (WhatsApp)
# ─────────────────────────────────────────────────────────────────────────────
EVOLUTION_API_URL=https://seu-evolution-api.com
EVOLUTION_API_KEY=sua_api_key_do_evolution

# ─────────────────────────────────────────────────────────────────────────────
# SMTP (Para emails de convite de agentes)
# ─────────────────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu@email.com
SMTP_PASS=sua_senha_de_app_ou_smtp
SMTP_FROM=noreply@seudominio.com

# ─────────────────────────────────────────────────────────────────────────────
# MINIO (S3-compatible file storage)
# Para desenvolvimento local com MinIO Docker:
#   docker run -p 9000:9000 -p 9001:9001 \
#     -e MINIO_ROOT_USER=minioadmin \
#     -e MINIO_ROOT_PASSWORD=minioadmin \
#     quay.io/minio/minio server /data --console-address ":9001"
# ─────────────────────────────────────────────────────────────────────────────
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=midias
# URL pública usada pelo browser para acessar os arquivos
MINIO_PUBLIC_URL=http://localhost:9000/midias
MINIO_REGION=us-east-1

# ─────────────────────────────────────────────────────────────────────────────
# APP
# ─────────────────────────────────────────────────────────────────────────────
SITE_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────────────────────
# OPENROUTER (AI - opcional)
# ─────────────────────────────────────────────────────────────────────────────
OPENROUTER_APIKEY=sk-or-v1-...
